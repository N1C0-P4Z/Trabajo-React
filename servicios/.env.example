# Obligatoria para la API
JWT_SECRET=

# Solo para el seed (prisma db seed)
ADMIN_PASSWORD=

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_EXPIRES_IN=24h

# Base de datos
DATABASE_URL="file:./dev.db"

# reCAPTCHA v2 (opcional en desarrollo)
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# Rate limiting (solo en producción; default 5 intentos / 15 min)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
