# ── Required ──────────────────────────────────────────────────────
# JWT_SECRET: App crashes without it. Use a strong random string.
JWT_SECRET=

# ADMIN_PASSWORD: Seed script creates admin with this password.
ADMIN_PASSWORD=

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_EXPIRES_IN=24h

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── reCAPTCHA v2 (optional in DEV, required in PROD) ─────────────
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
